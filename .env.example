# AfriBiz Architect — Variables d'environnement

# ============================================================
# SUPABASE — https://supabase.com/dashboard
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# GEMINI API — https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# ============================================================
# REDIS — Redis local ou Redis Cloud
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# SESSION & SÉCURITÉ
# ============================================================
SESSION_SECRET=change-me-to-a-very-long-random-string-at-least-64-chars
SESSION_COOKIE_DOMAIN=localhost
# En production, utiliser le domaine réel ex: .afribiz.io
NODE_ENV=development

# ============================================================
# APPLICATION
# ============================================================
API_PORT=3001
API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# ============================================================
# MODE DÉMONSTRATION
# Active le dossier fictif si Supabase/Gemini ne sont pas configurés
# Mettre false en production avec les vrais services
# ============================================================
DEMO_MODE=true

# ============================================================
# QUOTAS IA (optionnel — limites par utilisateur)
# ============================================================
MAX_GENERATIONS_PER_DAY=5
MAX_IMAGE_GENERATIONS_PER_DAY=20
MAX_CONCURRENT_IMAGE_JOBS=2
